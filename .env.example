NODE_ENV=development
PORT=5003
BASE_URL=http://localhost:5003

MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname

GOOGLE_CLIENT_ID_WEB=your_google_client_id_web
GOOGLE_CLIENT_ID_ANDROID=your_google_client_id_android
GOOGLE_CLIENT_ID_IOS=your_google_client_id_ios

HASH_SECRET_KEY=your_hash_secret_key

APP_ID=your_app_id
APP_CERTIFICATE=your_app_certificate

ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+8801700000000
ADMIN_PASSWORD=your_admin_password

JWT_ACCESS_TOKEN_SECRET=your_jwt_access_secret
JWT_ACCESS_TOKEN_EXPIRESIN=1d
JWT_REFRESH_TOKEN_SECRET=your_jwt_refresh_secret
JWT_REFRESH_TOKEN_EXPIRESIN=7d

TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

OTP_EXPIRY_MINUTES=5

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

SERVER_SECRET=your_server_secret
CALLBACK_SECRET=your_callback_secret

FIREBASE_PROJECT_ID=your_firebase_project_id
